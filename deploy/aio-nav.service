# Template: run aio_nav_node under systemd so it starts at boot and is independent
# of the dashboard (spec §5). Installed only with `install.sh --with-aio-nav`.
# @USER@ and @AIO_NAV_BIN@ are replaced by install.sh. The wrapper sources ROS 2 and
# the aio-nav-ros overlay itself and uses the package aio_nav.yaml.
#
# Note: the AIO Nav desktop app (aio-nav-ui) starts/stops the same node by process
# name. When this unit is enabled, prefer `systemctl start|stop aio-nav` instead.
[Unit]
Description=AIO NAV filter (aio_nav_node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Environment=ROS_DOMAIN_ID=13
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=@AIO_NAV_BIN@
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
