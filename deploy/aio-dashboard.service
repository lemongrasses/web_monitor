# AIO System Dashboard (Product :8080, Maintenance :8081).
# Installed by deploy/install.sh, which replaces @USER@ and @PREFIX@.
# The dashboard monitors. When nav.allow_control is on it can also start AIO NAV / DSO (like the
# AIO Nav desktop app); KillMode=process keeps them running when the dashboard restarts.
[Unit]
Description=AIO System Dashboard
# Not network-online.target: the dashboard needs no network to start, and without any network that
# target waits up to 30 s. Addresses that come later (the vehicle link) are used when they appear.
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PREFIX@
# ROS environment: match the drivers whose topics the dashboard monitors
# (here the camera/IMU drivers on domain 10, localhost only). The launcher keeps these values.
Environment=ROS_DOMAIN_ID=10
Environment=ROS_LOCALHOST_ONLY=1
# The launcher sources ROS 2 (for rclpy) when present and starts the app in the foreground.
ExecStart=@PREFIX@/bin/aio-dashboard run
Restart=always
RestartSec=3
# The dashboard reports "alive" while its health and start-up loops run (sdnotify.py); hung for
# this long, systemd restarts it like a crash. AIO NAV / DSO keep running (KillMode=process).
WatchdogSec=60
NotifyAccess=main
# File descriptors for the core even when the web ports are busy (web/server.py caps connections).
LimitNOFILE=8192
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=10
# AIO NAV and DSO run in this unit's group. If the kernel kills one for lack of memory (DSO grows
# ~20 MB/s; its watchdog normally restarts it first), the dashboard keeps running: the default
# (stop) would stop the dashboard too, and the vehicle's 0x05 status packet with it.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
