#!/usr/bin/env bash
# aio-dashboard — control the AIO System Dashboard. Installed by install.sh.
set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG="$APP_DIR/config/dashboard.yaml"
UNIT=aio-dashboard.service

usage() {
  cat <<EOF
AIO System Dashboard $(cat "$APP_DIR/VERSION" 2>/dev/null || echo "")

Usage: aio-dashboard <command>

  start | stop | restart   control the background service
  status                   service state and web addresses
  logs                     follow the service log (Ctrl+C to quit)
  config                   edit the settings, check them, and offer a restart
  check                    check the settings file (YAML and the kind of each value)
  urls                     print the web addresses
  version                  print the installed version
  password                 set the password of the maintenance view (sign-in)
  run [args]               run in the foreground (used by systemd; also for debugging)

Settings: $CONFIG
EOF
}

# Python with the dashboard's own packages, run in the app folder: python3 -c imports from the
# current folder first, and some commands run as root.
app_py() {
  (cd "$APP_DIR" && PYTHONPATH="$APP_DIR/lib:$APP_DIR" python3 -c "$@")
}

# A value from the settings as the dashboard reads them (defaults filled in); $2 if that fails.
setting() {
  app_py '
import logging, sys
logging.disable(logging.CRITICAL)
from aio_system_dashboard.config import load_config
from aio_system_dashboard.web.auth import default_password_file
cfg = load_config(sys.argv[1])
key = sys.argv[2]
print(default_password_file(cfg) if key == "password_file" else cfg[key.split(".")[0]][key.split(".")[1]])
' "$CONFIG" "$1" 2>/dev/null || echo "$2"
}

urls() {
  local ip product maint
  product="$(setting product.port 8080)"
  maint="$(setting maintenance.port 8081)"
  for ip in $(hostname -I 2>/dev/null); do
    [[ "$ip" == *:* ]] && continue
    echo "  Product view      http://$ip:$product"
    echo "  Maintenance view  http://$ip:$maint"
  done
}

# The same reading as the dashboard: a YAML error fails (exit 1); values of the wrong kind,
# which the dashboard replaces by their defaults, are listed.
check_config() {
  app_py '
import logging, sys
logging.disable(logging.CRITICAL)
from aio_system_dashboard.config import load_config
try:
    cfg = load_config(sys.argv[1])
except Exception as e:
    print(f"Settings file has an error:\n{e}")
    sys.exit(1)
if cfg.problems:
    print("Settings file readable, but the dashboard replaces these by their defaults:")
    for p in cfg.problems:
        print("  " + p)
else:
    print("Settings file OK")
' "$CONFIG"
}

case "${1:-}" in
  run)
    shift
    if [[ -f /opt/ros/humble/setup.bash ]]; then
      set +u
      # shellcheck disable=SC1091
      source /opt/ros/humble/setup.bash
      set -u
    fi
    # Keep the ROS environment set by the systemd unit; defaults only when unset.
    export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-13}" ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}" PYTHONUNBUFFERED=1
    export PYTHONPATH="$APP_DIR/lib:$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
    cd "$APP_DIR"
    exec /usr/bin/python3 -c 'from aio_system_dashboard.__main__ import main; raise SystemExit(main())' \
      --config "$CONFIG" "$@"
    ;;
  start|stop|restart)
    sudo systemctl "$1" "$UNIT"
    [[ "$1" == stop ]] || { sleep 2; systemctl is-active --quiet "$UNIT" && { echo "Running."; urls; } || \
      echo "Not running. See: aio-dashboard logs"; }
    ;;
  status)
    systemctl status "$UNIT" --no-pager -n 5 || true
    echo; urls
    ;;
  logs)
    journalctl -u "$UNIT" -f -n 50
    ;;
  config)
    sudo "${EDITOR:-nano}" "$CONFIG"
    if check_config; then
      read -r -p "Restart the dashboard to apply? [Y/n] " ans
      [[ "${ans:-y}" =~ ^[Yy]$ ]] && sudo systemctl restart "$UNIT" && echo "Restarted."
    fi
    ;;
  check)
    check_config
    ;;
  urls)
    urls
    ;;
  version)
    cat "$APP_DIR/VERSION" 2>/dev/null || echo "unknown"
    ;;
  password)
    # Only a salted hash is stored, readable by root and the service user. The password goes to
    # Python on stdin, never on a command line.
    read -r -s -p "New maintenance password: " p1; echo
    read -r -s -p "Repeat it: " p2; echo
    [[ "$p1" == "$p2" ]] || { echo "The two passwords differ; nothing changed." >&2; exit 1; }
    (( ${#p1} >= 8 )) || { echo "Use at least 8 characters; nothing changed." >&2; exit 1; }
    owner="$(stat -c %U "$APP_DIR/logs" 2>/dev/null || echo root)"
    pwfile="$(setting password_file "$APP_DIR/config/maint_password")"
    cd "$APP_DIR"     # python3 -c imports from the current folder first, and this runs as root
    printf '%s' "$p1" | sudo env PYTHONPATH="$APP_DIR/lib:$APP_DIR" python3 -c \
      'import sys; from aio_system_dashboard.web.auth import write_password_file; write_password_file(sys.argv[1], sys.stdin.read())' \
      "$pwfile"
    sudo chown "root:$owner" "$pwfile"
    sudo chmod 0640 "$pwfile"
    echo "Password set. Sign in to the maintenance view with it."
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2; usage; exit 1
    ;;
esac
