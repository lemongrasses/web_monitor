#!/usr/bin/env bash
# aio-nav — start AIO NAV (aio_nav_node) with a config file. The dashboard's launcher
# (services.aio_nav.launch: aio-nav), installed to PREFIX/bin by deploy/install.sh. It works for
# either navigation package: both have <root>/install/<pkg>/share/<pkg>/config/aio_nav.yaml and
# <root>/install/<pkg>/lib/<pkg>/aio_nav_node, and the package name is read from the config path.
#   aio_nav_ros  (aio-nav-ros)  ships its own lib/<pkg>/aio-nav wrapper: that one is run.
#   aio_core_nav has no wrapper: the node is run as its aio_nav.launch.py does (YAML as the
#                parameters file and as the config_file parameter).
#
#   aio-nav [path/to/aio_nav.yaml]      default: the newest install found ($AIO_NAV_CONFIG first)
#
# ROS_DOMAIN_ID / ROS_LOCALHOST_ONLY come from the caller (the dashboard sets them from
# aio_nav.yaml, the mode, or its own environment). The node writes output/ relative to the
# current folder; the dashboard runs it next to install/.
set -euo pipefail

die() { echo "aio-nav: $*" >&2; exit 1; }

cfg="${1:-${AIO_NAV_CONFIG:-}}"
if [[ -z "$cfg" ]]; then
  cfg="$(ls -t /home/*/*/install/{aio_core_nav,aio_nav_ros}/share/*/config/aio_nav.yaml \
               /opt/*/install/{aio_core_nav,aio_nav_ros}/share/*/config/aio_nav.yaml 2>/dev/null | head -1 || true)"
  [[ -n "$cfg" ]] || die "no aio_nav.yaml found (give the config file as the argument)"
fi
[[ -f "$cfg" ]] || die "config file not found: $cfg"

# <prefix>/share/<pkg>/config/aio_nav.yaml -> pkg, prefix, and the install/ folder above it
cfgdir="$(cd "$(dirname "$cfg")" && pwd)"            # keeps symlinks (a symlink install points into src/)
pkg="$(basename "$(dirname "$cfgdir")")"
if [[ "$(basename "$(dirname "$(dirname "$cfgdir")")")" == share ]]; then
  prefix="$(dirname "$(dirname "$(dirname "$cfgdir")")")"
else
  # <root>/src/<pkg>/config/aio_nav.yaml: a colcon symlink install resolved into the source tree
  # (what a caller gets from realpath). The prefix is <root>/install/<pkg> for the nearest <root>
  # above the file that has the node built.
  prefix=""
  d="$cfgdir"
  while [[ "$d" != / ]]; do
    if [[ -x "$d/install/$pkg/lib/$pkg/aio_nav_node" ]]; then prefix="$d/install/$pkg"; break; fi
    d="$(dirname "$d")"
  done
  [[ -n "$prefix" ]] || die "not a <prefix>/share/<pkg>/config/ file, and no install/$pkg above it: $cfg"
fi
inst="$(dirname "$prefix")"
node="$prefix/lib/$pkg/aio_nav_node"
[[ -x "$node" ]] || die "$node not found (build $pkg first)"

set +u
# shellcheck disable=SC1091
source /opt/ros/humble/setup.bash
# shellcheck disable=SC1091
if [[ -f "$inst/setup.bash" ]]; then source "$inst/setup.bash"; else source "$prefix/share/$pkg/local_setup.bash"; fi
set -u

if [[ -x "$prefix/lib/$pkg/aio-nav" && "$prefix/lib/$pkg/aio-nav" != "$(readlink -f "$0")" ]]; then
  exec "$prefix/lib/$pkg/aio-nav" "$cfg"               # the package's own wrapper (aio_nav_ros)
fi
exec "$node" --ros-args -r __node:=aio_nav_node --params-file "$cfg" -p "config_file:=$cfg"
